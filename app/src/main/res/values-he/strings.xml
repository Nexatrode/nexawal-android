    <string name="section_about">אודות</string>
    <string name="about_disclaimer">תוכנה מורשית ברישיון MIT ולא מבוקרת. אתה אחראי לביטוי השחזור ולכספים שלך. הצומת המרוחקת שמוגדרת כברירת מחדל יכולה לראות את כתובת ה-IP שלך ואת שאילתות הסנכרון של הארנק — הפעל צומת משלך לפרטיות חזקה יותר. אומדני פיאט אופציונליים, אם מופעלים, פונים ל-api.kraken.com ול-api.frankfurter.dev.</string>

    <string name="section_fiat">Ước tính tiền pháp định</string>
    <string name="toggle_show_fiat">Hiện ước tính tiền pháp định</string>
    <string name="fiat_help">Không bắt buộc. Khi được bật, NexaWal sẽ lấy giá XMR công khai từ Kraken (api.kraken.com) và, nếu cần, tỷ giá tiền pháp định từ Frankfurter (api.frankfurter.dev). Các máy chủ đó sẽ thấy địa chỉ IP của bạn. Số tiền và địa chỉ không được gửi đi. Các truy vấn tiền pháp định dùng HTTPS clearnet và tách biệt với cài đặt node / proxy I2P. Đây chỉ là ước tính — XMR mới là thứ bạn gửi và giữ.</string>
    <string name="fiat_currency_label">Loại tiền</string>
    <string name="section_about">Giới thiệu</string>
    <string name="about_disclaimer">Phần mềm theo giấy phép MIT, chưa được kiểm toán. Bạn chịu trách nhiệm về cụm từ khôi phục và tiền của mình. Node từ xa mặc định có thể thấy địa chỉ IP và các truy vấn đồng bộ ví của bạn — hãy chạy node riêng để bảo mật tốt hơn. Ước tính tiền pháp định (tùy chọn), nếu được bật, sẽ liên hệ với api.kraken.com và api.frankfurter.dev.</string>
